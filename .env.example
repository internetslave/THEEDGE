NODE_ENV=production
PORT=5000
APP_VERSION=1.0.0
LOG_LEVEL=info

# Storage
EDGEIQ_STORAGE_MODE=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/edgeiq
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
TRUST_PROXY=1

# Security
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_BOOTSTRAP_SECRET=replace-with-a-long-random-secret-at-least-24-characters

# External providers
ODDS_API_KEY=
ANTHROPIC_API_KEY=
RACING_API_USER=
RACING_API_PASS=

# One-time JSONBin import only
JSONBIN_API_KEY=
JSONBIN_BIN_ID=
